# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your own Telegram numeric chat id (get it from @userinfobot) —
# the bot refuses everyone else.
ADMIN_CHAT_ID=123456789

# Your panel's public URL (the Railway *.up.railway.app domain, or your
# custom domain), no trailing slash.
PANEL_URL=https://your-panel.up.railway.app

# The panel's admin dashboard password (same one you use to log into
# the web dashboard).
PANEL_ADMIN_PASSWORD=change-me
